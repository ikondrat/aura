{
  "name": "aura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch backend/server.ts",
    "start": "node dist/backend/server.js",
    "test": "node --import=tsx --test-concurrency=1 --test backend/app.test.ts backend/research-agent.test.ts backend/db/usage-events.test.ts backend/db/conversations.test.ts backend/db/onboarding.test.ts",
    "db:migrate": "tsx backend/db/migrate.ts up",
    "db:rollback": "tsx backend/db/migrate.ts down"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
