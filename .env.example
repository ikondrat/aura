NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Required by the database migration commands.
DATABASE_URL=postgres://aura:aura@127.0.0.1:5432/aura_development
# Required for replies to Telegram users.
TELEGRAM_BOT_TOKEN=
# Required in production; Telegram includes this value in the webhook request header.
TELEGRAM_WEBHOOK_SECRET=
# Optional local/mock API endpoint; defaults to https://api.telegram.org.
TELEGRAM_API_BASE_URL=https://api.telegram.org
